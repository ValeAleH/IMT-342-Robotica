<?xml version="1.0"?>
<package format="3">
  <name>irb120_bridge</name>
  <version>0.1.0</version>
  <description>Puente ROS 2 - ABB IRC5 (IRB 120): estado por RWS, comando articular por socket RAPID, monitor FK con modelo propio. IMT-342 Hito 3.</description>
  <maintainer email="noreply@example.com">Valeria Alejandra Hoyos Tovar</maintainer>
  <license>BSD-3-Clause</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-requests</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
